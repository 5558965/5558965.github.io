# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_SECURE=tls

# Email de destination pour le formulaire de contact
CONTACT_TO_ADDRESS=destinataire@example.com

# Email d'expédition
MAIL_FROM_ADDRESS=no-reply@votre-domaine.com
MAIL_FROM_NAME="Portfolio Claver"

# Configuration Telegram (pour le tracking des visites)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789
